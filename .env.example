CANONICAL_PARSER_PAPER_PROJECTION_READINESS_MIN_OBSERVATION_MINUTES=5
CANONICAL_PARSER_PAPER_PROJECTION_READINESS_VALIDITY_MINUTES=30

# M26 PAPER admission certification (metadata-only, runtime disconnected)
CANONICAL_PARSER_PAPER_ADMISSION_CERTIFICATION_ENABLED=false
CANONICAL_PARSER_PAPER_ADMISSION_CERTIFICATION_VALIDITY_MINUTES=60

# M27 PAPER runtime binding (read-only account isolation)
CANONICAL_PARSER_PAPER_RUNTIME_BINDING_ENABLED=false
CANONICAL_PARSER_PAPER_RUNTIME_BINDING_VALIDITY_MINUTES=60

# M28 PAPER admission canary (read-only risk interlock)
CANONICAL_PARSER_PAPER_ADMISSION_CANARY_ENABLED=false
CANONICAL_PARSER_PAPER_ADMISSION_CANARY_VALIDITY_MINUTES=15
CANONICAL_PARSER_PAPER_ADMISSION_CANARY_MAX_SOURCE_RUNS=3
CANONICAL_PARSER_PAPER_ADMISSION_CANARY_MAX_RESULTS=25
