# =========================
# APPLICATION
# =========================
APP_NAME=SmartMoney AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
ENABLE_DOCS=true

# =========================
# DATABASE
# =========================
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/smartmoney
SQL_ECHO=false
DB_POOL_RECYCLE_SECONDS=1800

# =========================
# SOLANA / HELIUS
# =========================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=CHANGE_ME
HELIUS_REQUEST_TIMEOUT_SECONDS=20
HELIUS_MAX_RETRIES=3
HELIUS_RETRY_BASE_SECONDS=0.75
HELIUS_RETRY_MAX_SECONDS=8
HELIUS_CREDIT_GUARD_ENABLED=true
HELIUS_CREDIT_GUARD_ENFORCE_IN_NON_PRODUCTION=false
HELIUS_APP_DAILY_CREDIT_CAP=20000
HELIUS_ENHANCED_DAILY_CREDIT_CAP=10000
HELIUS_RPC_DAILY_CREDIT_CAP=10000
HELIUS_AUTOMATIC_ENHANCED_API_ENABLED=false

# =========================
# RAW BLOCKCHAIN CAPTURE
# Milestone 3: governed passive shadow capture, disabled by default.
# Retention deletion also remains disabled and requires explicit API confirmation.
# =========================
RAW_BLOCKCHAIN_CAPTURE_ENABLED=false
RAW_BLOCKCHAIN_CAPTURE_PROVIDERS=helius,solana_rpc
RAW_BLOCKCHAIN_CAPTURE_EVENT_TYPES=WALLET_HISTORY_RESPONSE,ENHANCED_TRANSACTION_RESPONSE,RPC_RESPONSE
RAW_BLOCKCHAIN_CAPTURE_MAX_PAYLOAD_BYTES=4000000
RAW_BLOCKCHAIN_CAPTURE_RETENTION_DAYS=30
RAW_BLOCKCHAIN_CAPTURE_RETENTION_BATCH_SIZE=1000
RAW_BLOCKCHAIN_CAPTURE_PRUNE_ENABLED=false

# Manual versioned replay. Keep disabled until preview and explicit approval.
RAW_BLOCKCHAIN_REPLAY_ENABLED=false
RAW_BLOCKCHAIN_REPLAY_ALLOWED_PARSERS=raw_event_envelope
RAW_BLOCKCHAIN_REPLAY_MAX_BATCH_SIZE=100

# =========================
# INTERNAL API SECURITY
# =========================
AUTOMATION_API_KEY=
PAPER_TRADING_API_KEY=
LIVE_TRADING_API_KEY=
PUBLIC_DISCOVERY_COOLDOWN_SECONDS=120

# =========================
# JUPITER
# =========================
JUPITER_API_KEY=
JUPITER_PRICE_API_URL=https://api.jup.ag/price/v3
JUPITER_PRICE_TIMEOUT_SECONDS=10
JUPITER_PRICE_CACHE_SECONDS=15
JUPITER_SWAP_API_URL=https://api.jup.ag/swap/v2
JUPITER_SWAP_TIMEOUT_SECONDS=20

# =========================
# TOKEN SAFETY / MARKET DATA
# =========================
DEXSCREENER_API_URL=https://api.dexscreener.com
TOKEN_SAFETY_TIMEOUT_SECONDS=12
# Facoltativo. Inserire un URL completo con il placeholder {mint}.
RUGCHECK_API_URL=
RUGCHECK_API_KEY=

# Ogni transazione LIVE deve superare simulateTransaction prima dell'invio.
LIVE_TRADING_REQUIRE_SIMULATION=true

# =========================
# LIVE TRADING WALLET
# Lascia vuoto durante DRY_RUN.
# =========================
LIVE_TRADING_WALLET_ADDRESS=
LIVE_TRADING_PRIVATE_KEY=

# =========================
# HELIUS LIVE STREAM WORKER
# =========================
# Avvia il worker nello stesso processo FastAPI.
# false in locale; true nel backend Railway.
RUN_LIVE_STREAM_WORKER=false

# Riavvio del worker se termina inaspettatamente.
LIVE_STREAM_EMBEDDED_RESTART_SECONDS=5

# Tempo massimo concesso allo shutdown.
LIVE_STREAM_SHUTDOWN_TIMEOUT_SECONDS=25
LIVE_STREAM_POLICY_REFRESH_SECONDS=10
LIVE_STREAM_HEARTBEAT_SECONDS=15
LIVE_STREAM_LEASE_SECONDS=60
LIVE_STREAM_RECONNECT_MIN_SECONDS=2
LIVE_STREAM_RECONNECT_MAX_SECONDS=60
LIVE_STREAM_PING_INTERVAL_SECONDS=45
LIVE_STREAM_PING_TIMEOUT_SECONDS=20
LIVE_STREAM_OPEN_TIMEOUT_SECONDS=20
LIVE_STREAM_SUBSCRIPTION_TIMEOUT_SECONDS=30
LIVE_STREAM_QUEUE_SIZE=500
LIVE_STREAM_CONSUMERS=4
LIVE_STREAM_RECENT_SIGNATURES=10000

# =========================
# CORS
# =========================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CORS_ALLOW_CREDENTIALS=true
# =========================================
# POSITION MONITOR / AUTOMATIC EXITS
# =========================================
# Mantieni false durante l'installazione. Attivalo solo dopo i test DRY_RUN.
RUN_LIVE_POSITION_MONITOR=false
LIVE_POSITION_MONITOR_INTERVAL_SECONDS=30
LIVE_POSITION_MONITOR_LEASE_SECONDS=120
LIVE_POSITION_MONITOR_RESTART_SECONDS=5
LIVE_POSITION_MONITOR_SHUTDOWN_TIMEOUT_SECONDS=25
LIVE_POSITION_MONITOR_BATCH_SIZE=100
LIVE_ORDER_RECONCILE_BATCH_SIZE=50


