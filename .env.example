# =========================
# APPLICATION
# =========================
APP_NAME=SmartMoney AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
ENABLE_DOCS=true

# =========================
# DATABASE
# =========================
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/smartmoney
SQL_ECHO=false
DB_POOL_RECYCLE_SECONDS=1800

# =========================
# SOLANA / HELIUS
# =========================
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
HELIUS_API_KEY=CHANGE_ME
HELIUS_REQUEST_TIMEOUT_SECONDS=20
HELIUS_MAX_RETRIES=3
HELIUS_RETRY_BASE_SECONDS=0.75
HELIUS_RETRY_MAX_SECONDS=8

# =========================
# RAW BLOCKCHAIN CAPTURE
# Milestone 3: governed passive shadow capture, disabled by default.
# Retention deletion also remains disabled and requires explicit API confirmation.
# =========================
RAW_BLOCKCHAIN_CAPTURE_ENABLED=false
RAW_BLOCKCHAIN_CAPTURE_PROVIDERS=helius,solana_rpc
RAW_BLOCKCHAIN_CAPTURE_EVENT_TYPES=WALLET_HISTORY_RESPONSE,ENHANCED_TRANSACTION_RESPONSE,RPC_RESPONSE
RAW_BLOCKCHAIN_CAPTURE_MAX_PAYLOAD_BYTES=4000000
RAW_BLOCKCHAIN_CAPTURE_RETENTION_DAYS=30
RAW_BLOCKCHAIN_CAPTURE_RETENTION_BATCH_SIZE=1000
RAW_BLOCKCHAIN_CAPTURE_PRUNE_ENABLED=false

# Manual versioned replay. Keep disabled until preview and explicit approval.
RAW_BLOCKCHAIN_REPLAY_ENABLED=false
RAW_BLOCKCHAIN_REPLAY_ALLOWED_PARSERS=raw_event_envelope
RAW_BLOCKCHAIN_REPLAY_MAX_BATCH_SIZE=100

# =========================
# INTERNAL API SECURITY
# =========================
AUTOMATION_API_KEY=
PAPER_TRADING_API_KEY=
LIVE_TRADING_API_KEY=
PUBLIC_DISCOVERY_COOLDOWN_SECONDS=120

# =========================
# JUPITER
# =========================
JUPITER_API_KEY=
JUPITER_PRICE_API_URL=https://api.jup.ag/price/v3
JUPITER_PRICE_TIMEOUT_SECONDS=10
JUPITER_PRICE_CACHE_SECONDS=15
JUPITER_SWAP_API_URL=https://api.jup.ag/swap/v2
JUPITER_SWAP_TIMEOUT_SECONDS=20

# =========================
# TOKEN SAFETY / MARKET DATA
# =========================
DEXSCREENER_API_URL=https://api.dexscreener.com
TOKEN_SAFETY_TIMEOUT_SECONDS=12
# Facoltativo. Inserire un URL completo con il placeholder {mint}.
RUGCHECK_API_URL=
RUGCHECK_API_KEY=

# Ogni transazione LIVE deve superare simulateTransaction prima dell'invio.
LIVE_TRADING_REQUIRE_SIMULATION=true

# =========================
# LIVE TRADING WALLET
# Lascia vuoto durante DRY_RUN.
# =========================
LIVE_TRADING_WALLET_ADDRESS=
LIVE_TRADING_PRIVATE_KEY=

# =========================
# HELIUS LIVE STREAM WORKER
# =========================
# Avvia il worker nello stesso processo FastAPI.
# false in locale; true nel backend Railway.
RUN_LIVE_STREAM_WORKER=false

# Riavvio del worker se termina inaspettatamente.
LIVE_STREAM_EMBEDDED_RESTART_SECONDS=5

# Tempo massimo concesso allo shutdown.
LIVE_STREAM_SHUTDOWN_TIMEOUT_SECONDS=25
LIVE_STREAM_POLICY_REFRESH_SECONDS=10
LIVE_STREAM_HEARTBEAT_SECONDS=15
LIVE_STREAM_LEASE_SECONDS=60
LIVE_STREAM_RECONNECT_MIN_SECONDS=2
LIVE_STREAM_RECONNECT_MAX_SECONDS=60
LIVE_STREAM_PING_INTERVAL_SECONDS=45
LIVE_STREAM_PING_TIMEOUT_SECONDS=20
LIVE_STREAM_OPEN_TIMEOUT_SECONDS=20
LIVE_STREAM_SUBSCRIPTION_TIMEOUT_SECONDS=30
LIVE_STREAM_QUEUE_SIZE=500
LIVE_STREAM_CONSUMERS=4
LIVE_STREAM_RECENT_SIGNATURES=10000

# =========================
# CORS
# =========================
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
CORS_ALLOW_CREDENTIALS=true
# =========================================
# POSITION MONITOR / AUTOMATIC EXITS
# =========================================
# Mantieni false durante l'installazione. Attivalo solo dopo i test DRY_RUN.
RUN_LIVE_POSITION_MONITOR=false
LIVE_POSITION_MONITOR_INTERVAL_SECONDS=30
LIVE_POSITION_MONITOR_LEASE_SECONDS=120
LIVE_POSITION_MONITOR_RESTART_SECONDS=5
LIVE_POSITION_MONITOR_SHUTDOWN_TIMEOUT_SECONDS=25
LIVE_POSITION_MONITOR_BATCH_SIZE=100
LIVE_ORDER_RECONCILE_BATCH_SIZE=50


# Controlled Discovery Hydration (manual only)
DISCOVERY_HYDRATION_DEFAULT_WALLETS=3
DISCOVERY_HYDRATION_MAX_WALLETS_PER_RUN=10
DISCOVERY_HYDRATION_MAX_HELIUS_REQUESTS_PER_RUN=10
DISCOVERY_HYDRATION_LOOKBACK_DAYS=7
DISCOVERY_HYDRATION_TRANSACTION_LIMIT=100
DISCOVERY_HYDRATION_COOLDOWN_HOURS=12

# Canonical normalization and shadow validation (manual only)
CANONICAL_NORMALIZATION_ENABLED=false
CANONICAL_NORMALIZATION_MAX_BATCH_SIZE=100
CANONICAL_SHADOW_VALIDATION_ENABLED=false
CANONICAL_SHADOW_VALIDATION_MAX_BATCH_SIZE=200
CANONICAL_SHADOW_AMOUNT_TOLERANCE=0.000000001

# Canonical quality gate (assessment-only, manual)
CANONICAL_QUALITY_GATE_ENABLED=false
CANONICAL_QUALITY_GATE_MIN_COMPARABLE_EVENTS=50
CANONICAL_QUALITY_GATE_MIN_MATCH_RATE=98.0
CANONICAL_QUALITY_GATE_MAX_MISMATCH_RATE=2.0
CANONICAL_QUALITY_GATE_MAX_MISSING_TRADE_RATE=10.0
CANONICAL_QUALITY_GATE_MAX_NOT_COMPARABLE_RATE=5.0
CANONICAL_QUALITY_GATE_MAX_FAILED_RATE=0.5
CANONICAL_QUALITY_GATE_MIN_PASS_QUALITY_RATE=95.0
CANONICAL_QUALITY_GATE_MAX_EVIDENCE_AGE_HOURS=168

# Canonical parser promotion ledger (audit-only; disabled by default)
CANONICAL_PARSER_PROMOTION_ENABLED=false
CANONICAL_PARSER_PROMOTION_MAX_ASSESSMENT_AGE_HOURS=168

# Canonical parser SHADOW_ONLY runtime binding (metadata-only; disabled)
CANONICAL_PARSER_RUNTIME_BINDING_ENABLED=false
CANONICAL_PARSER_RUNTIME_ADMISSION_ENABLED=false
CANONICAL_PARSER_RUNTIME_ADMISSION_MAX_SAMPLE_SIZE=25

# Manual certification of successful admission evidence. Metadata-only; disabled by default.
CANONICAL_PARSER_RUNTIME_CERTIFICATION_ENABLED=false
CANONICAL_PARSER_RUNTIME_CERTIFICATION_MIN_RUNS=2
CANONICAL_PARSER_RUNTIME_CERTIFICATION_MIN_TOTAL_EVENTS=10
CANONICAL_PARSER_RUNTIME_CERTIFICATION_MIN_PASS_RATE=100
CANONICAL_PARSER_RUNTIME_CERTIFICATION_MAX_FAILED_EVENTS=0
CANONICAL_PARSER_RUNTIME_CERTIFICATION_MAX_EVIDENCE_AGE_HOURS=24
CANONICAL_PARSER_RUNTIME_CERTIFICATION_VALIDITY_HOURS=24

# M11 certified shadow runtime lease (metadata-only; disabled by default)
CANONICAL_PARSER_SHADOW_LEASE_ENABLED=false
CANONICAL_PARSER_SHADOW_LEASE_MAX_VALIDITY_MINUTES=60
CANONICAL_PARSER_SHADOW_LEASE_MIN_CERTIFICATION_REMAINING_MINUTES=15

# M12 certified shadow consumer dry-run (manual, bounded, disabled by default)
CANONICAL_PARSER_SHADOW_CONSUMER_ENABLED=false
CANONICAL_PARSER_SHADOW_CONSUMER_MAX_SAMPLE_SIZE=25
# M13 shadow consumer readiness assessment (manual evidence gate; disabled by default)
CANONICAL_PARSER_SHADOW_READINESS_ENABLED=false
CANONICAL_PARSER_SHADOW_READINESS_MIN_RUNS=3
CANONICAL_PARSER_SHADOW_READINESS_MAX_RUNS=20
CANONICAL_PARSER_SHADOW_READINESS_MIN_TOTAL_EVENTS=15
CANONICAL_PARSER_SHADOW_READINESS_MIN_UNIQUE_EVENTS=10
CANONICAL_PARSER_SHADOW_READINESS_MIN_PASS_RATE=100
CANONICAL_PARSER_SHADOW_READINESS_MAX_FAILED_EVENTS=0
CANONICAL_PARSER_SHADOW_READINESS_MAX_SKIPPED_EVENTS=0
CANONICAL_PARSER_SHADOW_READINESS_MIN_OBSERVATION_SPAN_MINUTES=5
CANONICAL_PARSER_SHADOW_READINESS_MAX_EVIDENCE_AGE_MINUTES=30
CANONICAL_PARSER_SHADOW_READINESS_VALIDITY_MINUTES=15

# Certified shadow automation permit (manual metadata-only; disabled by default)
CANONICAL_PARSER_SHADOW_AUTOMATION_PERMIT_ENABLED=false
CANONICAL_PARSER_SHADOW_AUTOMATION_PERMIT_MAX_VALIDITY_MINUTES=10
CANONICAL_PARSER_SHADOW_AUTOMATION_PERMIT_MIN_READINESS_REMAINING_MINUTES=2
CANONICAL_PARSER_SHADOW_AUTOMATION_PERMIT_MAX_RUN_BUDGET=5
CANONICAL_PARSER_SHADOW_AUTOMATION_PERMIT_MAX_EVENT_BUDGET=100

# M15 certified shadow execution ticket (manual atomic reservation; disabled)
CANONICAL_PARSER_SHADOW_EXECUTION_TICKET_ENABLED=false
CANONICAL_PARSER_SHADOW_EXECUTION_TICKET_MAX_VALIDITY_SECONDS=180
CANONICAL_PARSER_SHADOW_EXECUTION_TICKET_MIN_PERMIT_REMAINING_SECONDS=30
CANONICAL_PARSER_SHADOW_EXECUTION_TICKET_MAX_EVENT_RESERVATION=25

# M16 ticket-bound shadow execution (manual, atomic settlement; disabled)
CANONICAL_PARSER_SHADOW_TICKET_EXECUTION_ENABLED=false
CANONICAL_PARSER_SHADOW_TICKET_EXECUTION_MAX_SAMPLE_SIZE=25

# M17 manual shadow automation cycle coordinator
CANONICAL_PARSER_SHADOW_AUTOMATION_CYCLE_ENABLED=false
CANONICAL_PARSER_SHADOW_AUTOMATION_CYCLE_MAX_EVENT_RESERVATION=25
CANONICAL_PARSER_SHADOW_AUTOMATION_CYCLE_MAX_EXECUTION_LIMIT=25
CANONICAL_PARSER_SHADOW_AUTOMATION_CYCLE_TICKET_VALIDITY_SECONDS=120

# M18 persistent shadow scheduler control plane (manual tick only)
CANONICAL_PARSER_SHADOW_SCHEDULER_ENABLED=false
CANONICAL_PARSER_SHADOW_SCHEDULER_MIN_INTERVAL_SECONDS=300
CANONICAL_PARSER_SHADOW_SCHEDULER_MAX_INTERVAL_SECONDS=3600
CANONICAL_PARSER_SHADOW_SCHEDULER_LOCK_TTL_SECONDS=180
CANONICAL_PARSER_SHADOW_SCHEDULER_HEARTBEAT_TIMEOUT_SECONDS=300
CANONICAL_PARSER_SHADOW_SCHEDULER_MAX_EVENT_RESERVATION=25
CANONICAL_PARSER_SHADOW_SCHEDULER_MAX_EXECUTION_LIMIT=25

# M19 shadow scheduler worker lease/fencing (single iteration only)
CANONICAL_PARSER_SHADOW_WORKER_ENABLED=false
CANONICAL_PARSER_SHADOW_WORKER_LEASE_TTL_SECONDS=120
CANONICAL_PARSER_SHADOW_WORKER_HEARTBEAT_TIMEOUT_SECONDS=180
CANONICAL_PARSER_SHADOW_WORKER_MAX_CONSECUTIVE_FAILURES=3

# M20 bounded shadow worker loop and circuit breaker (no background daemon)
CANONICAL_PARSER_SHADOW_WORKER_LOOP_ENABLED=false
CANONICAL_PARSER_SHADOW_WORKER_LOOP_MAX_ITERATIONS=5
CANONICAL_PARSER_SHADOW_WORKER_LOOP_MAX_CONSECUTIVE_FAILURES=2
CANONICAL_PARSER_SHADOW_WORKER_LOOP_ENFORCE_KILL_SWITCH=false
# M21 manual shadow worker recovery/reconciliation
CANONICAL_PARSER_SHADOW_WORKER_RECOVERY_ENABLED=false
CANONICAL_PARSER_SHADOW_WORKER_RECOVERY_STALE_AFTER_SECONDS=300
CANONICAL_PARSER_SHADOW_WORKER_RECOVERY_MAX_TARGETS=100

# M22 shadow automation reliability evidence gate (no PAPER/LIVE admission)
CANONICAL_PARSER_SHADOW_RELIABILITY_ENABLED=false
CANONICAL_PARSER_SHADOW_RELIABILITY_LOOKBACK_MINUTES=60
CANONICAL_PARSER_SHADOW_RELIABILITY_MIN_LOOP_RUNS=3
CANONICAL_PARSER_SHADOW_RELIABILITY_MIN_ITERATIONS=10
CANONICAL_PARSER_SHADOW_RELIABILITY_MIN_PASS_RATE=95.0
CANONICAL_PARSER_SHADOW_RELIABILITY_MAX_FAILED_ITERATIONS=0
CANONICAL_PARSER_SHADOW_RELIABILITY_MAX_CIRCUIT_OPEN_RUNS=0
CANONICAL_PARSER_SHADOW_RELIABILITY_MAX_RECOVERY_ACTIONS=0
CANONICAL_PARSER_SHADOW_RELIABILITY_MIN_OBSERVATION_MINUTES=5
CANONICAL_PARSER_SHADOW_RELIABILITY_VALIDITY_MINUTES=15

# M23 manual shadow reliability certification (no PAPER/LIVE execution)
CANONICAL_PARSER_SHADOW_RELIABILITY_CERTIFICATION_ENABLED=false
CANONICAL_PARSER_SHADOW_RELIABILITY_CERTIFICATION_VALIDITY_MINUTES=60

# M24 PAPER projection dry-run (projection tables only)
CANONICAL_PARSER_PAPER_PROJECTION_ENABLED=false
CANONICAL_PARSER_PAPER_PROJECTION_LOOKBACK_MINUTES=1440
CANONICAL_PARSER_PAPER_PROJECTION_MAX_SOURCE_RUNS=10
CANONICAL_PARSER_PAPER_PROJECTION_MAX_ARTIFACTS=100
CANONICAL_PARSER_PAPER_PROJECTION_MIN_PROJECTABLE_RESULTS=1

# M25 PAPER projection evidence gate (no PAPER execution)
CANONICAL_PARSER_PAPER_PROJECTION_READINESS_ENABLED=false
CANONICAL_PARSER_PAPER_PROJECTION_READINESS_LOOKBACK_MINUTES=1440
CANONICAL_PARSER_PAPER_PROJECTION_READINESS_MAX_SOURCE_RUNS=20
CANONICAL_PARSER_PAPER_PROJECTION_READINESS_MIN_RUNS=3
CANONICAL_PARSER_PAPER_PROJECTION_READINESS_MIN_RESULTS=3
CANONICAL_PARSER_PAPER_PROJECTION_READINESS_MIN_PROJECTABLE_RATE=100.0
CANONICAL_PARSER_PAPER_PROJECTION_READINESS_MAX_REVIEW_RESULTS=0
