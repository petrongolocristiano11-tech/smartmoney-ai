{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "/backend/**",
      "/alembic/**",
      "/alembic.ini",
      "/requirements.txt",
      "/railway.worker.json"
    ]
  },
  "deploy": {
    "startCommand": "python -m backend.app.workers.helius_live_trading_worker",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": "20"
  }
} 